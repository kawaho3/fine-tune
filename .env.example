# Local development only. Never put secrets or production credentials here.
HOST=127.0.0.1
PORT=3000

# Model gateway defaults to the deterministic offline provider.
MODEL_PROVIDER=mock
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=1
MODEL_RETRY_DELAY_MS=100

# Local Ollama is opt-in. No model is downloaded automatically.
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-model
# OLLAMA_ALLOW_REMOTE=false

# OpenHands Agent Server compatibility adapter. Local-only by default.
OPENHANDS_BASE_URL=http://127.0.0.1:8000
OPENHANDS_TIMEOUT_MS=30000
OPENHANDS_MAX_ITERATIONS=25
OPENHANDS_ALLOW_REMOTE=false
# OPENHANDS_SESSION_API_KEY=local-session-key
