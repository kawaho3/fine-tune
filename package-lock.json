{
  "name": "fine-tune",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fine-tune",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@fine-tune/api",
      "version": "0.1.0",
      "dependencies": {
        "@fine-tune/core": "0.1.0"
      }
    },
    "apps/web": {
      "name": "@fine-tune/web",
      "version": "0.1.0"
    },
    "node_modules/@fine-tune/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@fine-tune/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@fine-tune/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/core": {
      "name": "@fine-tune/core",
      "version": "0.1.0"
    }
  }
}
